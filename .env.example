# Environment variables for local development.
#
# Copy this file to `.env.local` and fill in the real values. `.env.local`
# is gitignored. In Vercel, these are auto-injected by the Supabase
# marketplace integration for Production; locally you populate them by
# hand from the Supabase dashboard (Project Settings → API).
#
# DO NOT commit real values to this file.

# ─────────────────────────────────────────────────────────────────────
# Supabase — Phase 1 uses these for the /observe form submission flow.
# ─────────────────────────────────────────────────────────────────────

# Public project URL. Safe to expose in client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key. Safe to expose in client code. Subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role (secret) key. SERVER-ONLY. Bypasses RLS. Never expose to
# the browser. Used by the /observe server action to insert into the
# observation_requests table, and by the reminder cron to update rows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────────────
# Resend — Phase 1 transactional email (added in Step 7 of PLAN.md).
# Leave blank until Resend account + domain verification are set up.
# ─────────────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Recipient for the weekly USA Fencing membership report (Monday 12:00 UTC cron
# at /api/cron/usaf-report). The report CSV of newly-completed members is emailed
# here; if no new members enrolled that week, no email is sent.
REPORT_RECIPIENT_EMAIL=

# ─────────────────────────────────────────────────────────────────────
# Cron security (added in Step 9 of PLAN.md).
# ─────────────────────────────────────────────────────────────────────

# Secret used to authenticate Vercel's cron invocations. Vercel sends this
# automatically as "Authorization: Bearer <value>" when it triggers the cron
# route. Generate a random string of at least 16 characters (e.g. via
# 1Password or `openssl rand -base64 24`). Add to:
#   1. .env.local (local dev — lets you test the route at /api/cron/remind)
#   2. Vercel dashboard → Project Settings → Environment Variables (Production)
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Phase 2 — Site URL (used for auth redirect URLs).
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://dmfc-site.vercel.app
